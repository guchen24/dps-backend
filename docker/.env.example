# Required only to make model requests. Get a key from https://platform.deepseek.com.
# Never commit the real .env file.
DEEPSEEK_API_KEY=sk-xxx

# Optional OpenAI-compatible DeepSeek endpoint override.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Docker publishes only this loopback port.
DSH_PORT=3080

# Host directory mounted as the Harness working directory. Keep it separate
# from the deployment root because Harness reads a workspace .env itself.
# On Windows, use an absolute path only if you want another local project.
DSH_WORKSPACE=../workspace
